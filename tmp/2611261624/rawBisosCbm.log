set -e

# banna sysAccts: prometheus uid=504, group prometheus gid=504
if getent group prometheus >/dev/null ; then
    liveGid=$(getent group prometheus | cut -d: -f3)
    [ "$liveGid" = "504" ] || \
        echo "banna: WARNING: group prometheus has gid $liveGid, banna assigns 504 -- see bannaInfo.cs -i bannaSysAcctsVerify" >&2
else
    holder=$(getent group 504 | cut -d: -f1)
    if [ -n "$holder" ] ; then
        echo "banna: ERROR: gid 504 (registered for group prometheus) is held by group $holder" >&2
        exit 1
    fi
    sudo groupadd -r -g 504 prometheus
fi
if getent passwd prometheus >/dev/null ; then
    liveUid=$(id -u prometheus)
    [ "$liveUid" = "504" ] || \
        echo "banna: WARNING: account prometheus has uid $liveUid, banna assigns 504 -- see bannaInfo.cs -i bannaSysAcctsVerify" >&2
else
    holder=$(getent passwd 504 | cut -d: -f1)
    if [ -n "$holder" ] ; then
        echo "banna: ERROR: uid 504 (registered for prometheus) is held by account $holder" >&2
        exit 1
    fi
    sudo useradd -r -u 504 -g prometheus -M -d /var/lib/prometheus \
        -s /usr/sbin/nologin -c 'Prometheus and its node_exporter (bisos.prometheus)' prometheus
fi


sudo mkdir -p /var/lib/prometheus/data /etc/prometheus /opt/prometheus
sudo chown -R prometheus:prometheus /var/lib/prometheus
sudo chmod 750 /var/lib/prometheus/data

