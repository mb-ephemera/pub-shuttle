# banna sysAccts: devpi uid=507, group devpi gid=507
if getent group devpi >/dev/null ; then
    liveGid=$(getent group devpi | cut -d: -f3)
    [ "$liveGid" = "507" ] || \
        echo "banna: WARNING: group devpi has gid $liveGid, banna assigns 507 -- see bannaInfo.cs -i bannaSysAcctsVerify" >&2
else
    holder=$(getent group 507 | cut -d: -f1)
    if [ -n "$holder" ] ; then
        echo "banna: ERROR: gid 507 (registered for group devpi) is held by group $holder" >&2
        exit 1
    fi
    sudo groupadd -r -g 507 devpi
fi
if getent passwd devpi >/dev/null ; then
    liveUid=$(id -u devpi)
    [ "$liveUid" = "507" ] || \
        echo "banna: WARNING: account devpi has uid $liveUid, banna assigns 507 -- see bannaInfo.cs -i bannaSysAcctsVerify" >&2
else
